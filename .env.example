APP_ENV=development
API_PORT=8000
WEB_PORT=3000
# Compose Postgres (required). Use a strong password outside pure local lab.
POSTGRES_DB=riotqueens
POSTGRES_USER=riotqueens
POSTGRES_PASSWORD=riotqueens_dev
# Host-side tooling only if you temporarily publish 127.0.0.1:5432.
# Prefer: docker compose exec postgres psql -U riotqueens -d riotqueens
# The api service injects postgresql://…@postgres:5432/… on the Compose network.
DATABASE_URL=postgresql://riotqueens:riotqueens_dev@localhost:5432/riotqueens
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=/api
# Enable only after the Auth0 CA non-production tenant is configured.
NEXT_PUBLIC_AUTH_ENABLED=false
SITE_ADDRESS=:80

# --- Auth0 IAM / C3 (server-side only) ---------------------------------
# Auth0 CA tenant (riotqueens-ai-ca). Secrets stay blank in this template.
# Create the Custom API (audience below) before enabling protected runtime.
RIOTQUEENS_AUTH_ENABLED=true
RIOTQUEENS_AUTH0_ISSUER=https://riotqueens-ai-ca.ca.auth0.com/
RIOTQUEENS_AUTH0_AUDIENCE=https://api.riotqueens.ai
RIOTQUEENS_AUTH0_JWKS_URL=https://riotqueens-ai-ca.ca.auth0.com/.well-known/jwks.json
# Auth0 Next.js SDK — Regular Web Application (server-side only).
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=riotqueens-ai-ca.ca.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://api.riotqueens.ai
AUTH0_SCOPE=openid profile email
# Machine-to-Machine lab client (client_credentials smoke). Not used by the browser.
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_M2M_AUDIENCE=https://api.riotqueens.ai

# --- Runtime model provider (server-side only) -------------------------
# Provider selection. "mock" (default) = deterministic local fallback.
# "openai" = OpenAI-compatible HTTP adapter. When provider=openai but
# BASE_URL or API_KEY is missing, the app falls back to mock so install,
# lint, build, test and run never require a real key.
RIOTQUEENS_MODEL_PROVIDER=mock
# OpenAI-compatible endpoint (server-side only; never exposed to client).
RIOTQUEENS_MODEL_BASE_URL=https://openrouter.ai/api/v1
# API key (server-side only; placeholder empty in .env.example).
RIOTQUEENS_MODEL_API_KEY=
# Model name to request.
RIOTQUEENS_MODEL_NAME=meta-llama/llama-3.3-70b-instruct
# Router tuning (overrides ModelRouter defaults).
RIOTQUEENS_MODEL_TIMEOUT_SECONDS=5.0
RIOTQUEENS_MODEL_MAX_RETRIES=1
# Sampling: higher temperature + mild frequency_penalty fight generic assistant voice.
RIOTQUEENS_MODEL_TEMPERATURE=0.9
RIOTQUEENS_MODEL_FREQUENCY_PENALTY=0.4
# Some OpenAI-compatible endpoints (including Gemini AI Studio) reject this
# parameter. Set true only after a documented provider smoke test.
RIOTQUEENS_MODEL_OMIT_FREQUENCY_PENALTY=false

# Optional second OpenAI-compatible provider. A guardrail break, identity
# leak or exhausted invalid output on the primary moves to this provider.
RIOTQUEENS_FALLBACK_MODEL_PROVIDER=
RIOTQUEENS_FALLBACK_MODEL_BASE_URL=https://router.huggingface.co/v1
RIOTQUEENS_FALLBACK_MODEL_API_KEY=
RIOTQUEENS_FALLBACK_MODEL_NAME=openai/gpt-oss-120b:ovhcloud
RIOTQUEENS_FALLBACK_MODEL_OMIT_FREQUENCY_PENALTY=false

# --- Lab credentials (server-side only; never expose to the browser) ----
# Keep empty in this template. Wire into RIOTQUEENS_MODEL_* only after casting.
# OpenRouter: https://openrouter.ai/api/v1
# Groq:       https://api.groq.com/openai/v1
# HF Router:  https://router.huggingface.co/v1
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
RIOTQUEENS_GEMINI_MODEL=gemini-3.1-flash-lite
OPENROUTER_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
RIOTQUEENS_OLLAMA_BASE_URL=http://localhost:11434
RIOTQUEENS_OLLAMA_MODEL=gemma4:e4b
# CORS: comma-separated allowed origins for the web client (dev only).
RIOTQUEENS_CORS_ORIGINS=http://localhost,http://localhost:3000

# --- Conversation & memory (server-side only) --------------------------
# In-process prototype state. NOT durable persistence — server restart
# clears all conversation history and memories. A future milestone
# will swap the in-process stores for a PostgreSQL backend without
# changing the API surface.

# Maximum number of complete user/assistant turns kept in conversation
# history per (user_id, character_id, conversation_id) scope. Older
# pairs are evicted FIFO. The bound is applied to PAIRS, so truncation
# never leaves a half-pair. The canonical Queen system prompt is NEVER
# stored and is re-prepended on every request.
RIOTQUEENS_CONVERSATION_MAX_TURNS=8

# Maximum number of explicit user-fact memories kept per
# (user_id, character_id) scope. Older memories are evicted FIFO.
RIOTQUEENS_MEMORY_MAX_PER_SCOPE=32
