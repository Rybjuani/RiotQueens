APP_ENV=development
API_PORT=8000
WEB_PORT=3000
DATABASE_URL=postgresql+asyncpg://companion:companion@localhost:5432/companion
REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Runtime model provider (server-side only) -------------------------
# Provider selection. "mock" (default) = deterministic local fallback.
# "openai" = OpenAI-compatible HTTP adapter. When provider=openai but
# BASE_URL or API_KEY is missing, the app falls back to mock so install,
# lint, build, test and run never require a real key.
COMPANION_MODEL_PROVIDER=mock
# OpenAI-compatible endpoint (server-side only; never exposed to client).
COMPANION_MODEL_BASE_URL=https://api.example.com/v1
# API key (server-side only; placeholder empty in .env.example).
COMPANION_MODEL_API_KEY=
# Model name to request.
COMPANION_MODEL_NAME=companion-chat-v1
# Router tuning (overrides ModelRouter defaults).
COMPANION_MODEL_TIMEOUT_SECONDS=5.0
COMPANION_MODEL_MAX_RETRIES=1
# CORS: comma-separated allowed origins for the web client (dev only).
COMPANION_CORS_ORIGINS=http://localhost:3000
